  "sources": {
    "blink.asm": "; LED blink on PB5 (Arduino pin 13) using Timer1 in CTC mode.\n; 16 MHz / 1024 / (7812 + 1) = 2 Hz interrupt -> LED toggles every 0.5 s.\n\n.org 0\n        jmp reset\n.org 0x16                       ; TIMER1_COMPA (vector 11)\n        jmp timer1_compa\n.org 0x34\nreset:\n        ldi r16, high(RAMEND)\n        out SPH, r16\n        ldi r16, low(RAMEND)\n        out SPL, r16\n\n        sbi DDRB, 5             ; PB5 output\n\n        ldi r16, high(7812)     ; 16-bit write: high byte first\n        sts OCR1AH, r16\n        ldi r16, low(7812)\n        sts OCR1AL, r16\n        ldi r16, (1<<WGM12)|(1<<CS12)|(1<<CS10)   ; CTC, clk/1024\n        sts TCCR1B, r16\n        ldi r16, 1<<OCIE1A\n        sts TIMSK1, r16\n        sei\nidle:\n        rjmp idle\n\ntimer1_compa:\n        sbi PINB, 5             ; writing 1 to PINx toggles PORTx\n        reti\n"
  }
}