  "sources": {
    "main.asm": "\n        ldi r16, high(RAMEND)\n        out SPH, r16\n        ldi r16, low(RAMEND)\n        out SPL, r16\n        sbi DDRB, 5        ; LED output\n        sbi PORTD, 2       ; button pull-up\nloop:   sbic PIND, 2       ; pressed = low\n        rjmp off\n        sbi PORTB, 5\n        rjmp loop\noff:    cbi PORTB, 5\n        rjmp loop"
  }
