  "sources": {
    "dimmer.asm": "; Potentiometer dimmer: ADC0 (PC0) is read continuously and copied to the\n; Timer0 PWM duty cycle on OC0A (PD6). Fast PWM, clk/64 -> 976 Hz.\n\n.def tmp = r16\n\n.org 0\n        rjmp reset\nreset:\n        ldi tmp, high(RAMEND)\n        out SPH, tmp\n        ldi tmp, low(RAMEND)\n        out SPL, tmp\n\n        sbi DDRD, 6                                 ; OC0A output\n        ldi tmp, (1<<COM0A1)|(1<<WGM01)|(1<<WGM00)  ; fast PWM, non-inverting\n        out TCCR0A, tmp\n        ldi tmp, (1<<CS01)|(1<<CS00)                ; clk/64\n        out TCCR0B, tmp\n\n        ldi tmp, (1<<REFS0)|(1<<ADLAR)              ; AVcc reference, ADC0, 8-bit result in ADCH\n        sts ADMUX, tmp\nconvert:\n        ldi tmp, (1<<ADEN)|(1<<ADSC)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0)\n        sts ADCSRA, tmp\nbusy:\n        lds tmp, ADCSRA\n        sbrc tmp, ADSC\n        rjmp busy\n        lds tmp, ADCH\n        out OCR0A, tmp\n        rjmp convert\n"
  }
}